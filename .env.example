# LLM: gemini | openai | anthropic | mock
LLM_PROVIDER=gemini
# Leave empty to use the provider's default model.
LLM_MODEL=
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# STT: faster-whisper (local, no key) | openai | mock
STT_PROVIDER=faster-whisper
# faster-whisper size: tiny | base | small | medium | large-v3. "small" suits a laptop CPU.
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Leave empty to auto-detect, which mixed-language lectures need. Set "ko" or "en" to force one.
STT_LANGUAGE=

# Embeddings: e5 (local) | mock
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Set to 1 to use only cached results and make no external calls.
DEMO_MODE=0
# Where job files and the cache live. Leave empty for <repo>/data.
DATA_DIR=
# Path to the ffmpeg binary. Leave empty to find it on PATH.
FFMPEG_PATH=

# Page alignment. Penalties are in cosine-similarity units. Leave empty for defaults.
ALIGN_NEXT_PAGE_PENALTY=
ALIGN_SKIP_PENALTY_PER_PAGE=
ALIGN_BACK_PENALTY=
ALIGN_OFF_TOPIC_THRESHOLD=
