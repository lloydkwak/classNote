# LLM: gemini | openai | anthropic | mock
LLM_PROVIDER=gemini
# Leave empty to use the provider's default. Gemini's default falls back to other free-tier
# models when one reaches its daily limit; a model set here is used alone.
LLM_MODEL=
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# STT: faster-whisper (local, no key) | openai | mock
STT_PROVIDER=faster-whisper
# faster-whisper size. large-v3-turbo was far more accurate than small on a real Korean lecture,
# and ran faster than real time on a 12-thread laptop CPU. Its download is about 1.6GB.
STT_MODEL=large-v3-turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Speech model for live recording, where speed matters more. Each job can also choose its own.
# On a 12-thread laptop CPU, per 60s of Korean audio: small about 17s, large-v3-turbo about 59s.
LIVE_STT_MODEL=small
# CPU threads for small models in live mode. More wasn't better on that laptop.
LIVE_STT_CPU_THREADS=6
# Leave empty to auto-detect, which mixed-language lectures need. Set "ko" or "en" to force one.
STT_LANGUAGE=

# Font for margin notes: pretendard | nanum-pen (handwriting)
NOTE_FONT=pretendard

# Annotation engine: v1 (margin notes) | v2 (in progress: word geometry and transcript evidence)
ANNOTATION_ENGINE=v1

# Embeddings: e5 (local) | mock
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Set to 1 to use only cached results and make no external calls.
DEMO_MODE=0
# Where job files and the cache live. Leave empty for <repo>/data.
DATA_DIR=
# Path to the ffmpeg binary. Leave empty to find it on PATH.
FFMPEG_PATH=

# Page alignment. Leave empty for defaults (0.2, 0.4, 1.0, -2.5).
# Penalties are in per-window z-score units. The threshold is how many robust standard
# deviations a window's best similarity may sit below the lecture's typical best.
ALIGN_NEXT_PAGE_PENALTY=
ALIGN_SKIP_PENALTY_PER_PAGE=
ALIGN_BACK_PENALTY=
ALIGN_OFF_TOPIC_THRESHOLD=
